<div class="group-grid" style="margin-top:8px;">
  {% for g in site.groups %}
  <div class="group">
    <span class="tag">{{ g.tag }}</span>
    <h3>{{ g.name }}</h3>
    <p>{{ g.desc }}</p>
  </div>
  {% endfor %}
</div>
