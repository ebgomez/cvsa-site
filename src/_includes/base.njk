<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · {{ site.title }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Libre+Franklin:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="top">
    <div class="nav-inner">
      <a href="/" class="logo">
        <svg class="logo-icon" width="34" height="39" viewBox="0 0 40 46" aria-hidden="true">
          <circle cx="20" cy="12" r="10.5" fill="var(--accent)"/>
          <g stroke="#141926" stroke-width="1.6" fill="none" stroke-linecap="round">
            <path d="M9.5 12h21"/>
            <path d="M20 1.5 Q26 12 20 22.5"/>
            <path d="M20 1.5 Q14 12 20 22.5"/>
          </g>
          <ellipse cx="20" cy="26" rx="12.5" ry="3" fill="none" stroke="var(--accent)" stroke-width="2.2"/>
          <g stroke="#D8DCE3" stroke-width="1" fill="none">
            <path d="M8 28 L14 42"/>
            <path d="M13 28.5 L17 42"/>
            <path d="M18 29 L19.5 42"/>
            <path d="M22 29 L20.5 42"/>
            <path d="M27 28.5 L23 42"/>
            <path d="M32 28 L26 42"/>
          </g>
        </svg>
        <span class="word">CVSA <span>Hoops</span></span>
      </a>
      <div class="nav-links">
        {% for item in site.nav %}
        <a href="{{ item.url }}">{{ item.text }}</a>
        {% endfor %}
      </div>
      <a href="/contact/" class="btn on-navy" style="padding:10px 18px;">Join a Game</a>
    </div>
  </nav>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="container foot-row">
      <div>© {% year %} {{ site.tagline }} · {{ site.contact.location }}</div>
      <div style="display:flex;gap:18px;">
        {% if site.social.facebook %}<a href="{{ site.social.facebook }}">Facebook</a>{% endif %}
        {% if site.social.instagram %}<a href="{{ site.social.instagram }}">Instagram</a>{% endif %}
      </div>
    </div>
  </footer>

</body>
</html>
