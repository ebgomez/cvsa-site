---
layout: base.njk
title: Home
permalink: /
---
<section class="hero">
  <div class="container hero-grid">
    <div>
      <div class="eyebrow" style="color:var(--accent);"><span class="ball"></span>{{ site.tagline }}</div>
      <h1>{{ site.home.heroHeadline }}</h1>
      <p class="dek">{{ site.home.heroDek }}</p>
      <div class="hero-ctas">
        <a href="/schedule/" class="btn on-navy">See This Week's Games</a>
        <a href="/about/" class="btn on-navy ghost">How It Works</a>
      </div>
    </div>
    <div class="scoreboard" id="next-game">
      <div class="sb-label">Next Game Day</div>
      <div class="sb-day-big" id="ng-day-big">{{ site.schedule[0].day }}</div>
      <div class="sb-sessions" id="ng-sessions">
        <div class="sb-session-block">
          <div class="sb-session-time">{{ site.schedule[0].time }}</div>
          <div class="sb-session-label">{{ site.schedule[0].focus }}</div>
        </div>
      </div>
      <div class="sb-divider"></div>
      <div class="sb-loc">{{ site.contact.location }}</div>
    </div>
  </div>
</section>

<script>
  var CVSA_SCHEDULE = {{ site.schedule | jsonify | safe }};
</script>
<script>
(function () {
  function parseTime(str) {
    var m = String(str).match(/(\d{1,2}):(\d{2})\s*([ap]m)/i);
    if (!m) return null;
    var h = parseInt(m[1], 10);
    var min = parseInt(m[2], 10);
    var ap = m[3].toLowerCase();
    if (ap === "pm" && h !== 12) h += 12;
    if (ap === "am" && h === 12) h = 0;
    return h * 60 + min;
  }
  function parseRange(str) {
    var parts = String(str).split(/[-–—]/);
    if (parts.length < 2) return null;
    var start = parseTime(parts[0]);
    var end = parseTime(parts[1]);
    if (start === null || end === null) return null;
    return { start: start, end: end };
  }

  var DAYS = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

  function getNowInGymTimezone() {
    var parts = new Intl.DateTimeFormat("en-US", {
      timeZone: "America/Los_Angeles",
      weekday: "long",
      hour: "2-digit",
      minute: "2-digit",
      hourCycle: "h23",
    }).formatToParts(new Date());
    var lookup = {};
    parts.forEach(function (p) { lookup[p.type] = p.value; });
    return {
      dayName: lookup.weekday,
      minutes: parseInt(lookup.hour, 10) * 60 + parseInt(lookup.minute, 10),
    };
  }

  // Finds the next game DAY (today or upcoming) and returns every session
  // on it that hasn't already ended yet — not just the single soonest one.
  function findNextGameDay(schedule, nowDayName, nowMinutes) {
    var startIdx = DAYS.indexOf(nowDayName);
    for (var offset = 0; offset < 8; offset++) {
      var dayName = DAYS[(startIdx + offset) % 7];
      var sessions = schedule
        .filter(function (s) { return s.day === dayName; })
        .map(function (s) { return Object.assign({}, s, { range: parseRange(s.time) }); })
        .filter(function (s) { return s.range && (offset > 0 || s.range.end > nowMinutes); })
        .sort(function (a, b) { return a.range.start - b.range.start; });
      if (sessions.length) {
        return { sessions: sessions, dayName: dayName, isToday: offset === 0 };
      }
    }
    return null;
  }

  try {
    if (!CVSA_SCHEDULE || !CVSA_SCHEDULE.length) return;
    var now = getNowInGymTimezone();
    var result = findNextGameDay(CVSA_SCHEDULE, now.dayName, now.minutes);
    if (!result) return;

    document.getElementById("ng-day-big").textContent = result.isToday ? "Today" : result.dayName;

    var list = document.getElementById("ng-sessions");
    list.innerHTML = "";
    result.sessions.forEach(function (s) {
      var block = document.createElement("div");
      block.className = "sb-session-block";
      var time = document.createElement("div");
      time.className = "sb-session-time";
      time.textContent = s.time;
      var label = document.createElement("div");
      label.className = "sb-session-label";
      label.textContent = s.focus;
      block.appendChild(time);
      block.appendChild(label);
      list.appendChild(block);
    });
  } catch (e) {
    /* Fall back to whatever was server-rendered above */
  }
})();
</script>

<section class="band">
  <div class="container">
    <div class="court-divider"><span class="eyebrow" style="margin:0;"><span class="ball"></span>Why Players Stay</span><div class="cd-line"></div></div>
    <div class="value-grid">
      {% for v in site.home.valueProps %}
      <div class="card">
        <h3>{{ v.title }}</h3>
        <p>{{ v.desc }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band" style="background:var(--surface-alt);">
  <div class="container">
    <div class="court-divider"><span class="eyebrow" style="margin:0;"><span class="ball"></span>Find Your Group</span><div class="cd-line"></div></div>
    <div class="group-grid">
      {% for g in site.groups %}
      <div class="group">
        <span class="tag">{{ g.tag }}</span>
        <h3>{{ g.name }}</h3>
        <p>{{ g.desc }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="band">
  <div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:48px;">
    <div>
      <div class="court-divider"><span class="eyebrow" style="margin:0;"><span class="ball"></span>On the Court</span><div class="cd-line"></div></div>
      <div class="news-list">
        {% for post in collections.posts | reverse %}
        {% if loop.index <= 3 %}
        <div class="news-item">
          <div class="news-date">{{ post.data.date | dateDisplay }}</div>
          <div><h3><a href="{{ post.url }}" style="color:inherit;">{{ post.data.title }}</a></h3><p>{{ post.data.excerpt }}</p></div>
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>
    <div>
      <div class="court-divider"><span class="eyebrow" style="margin:0;"><span class="ball"></span>From the Gym</span><div class="cd-line"></div></div>
      {% set homeMedia = gallery.photos | combineMedia(collections.videos, 6) %}
      <div class="gallery-grid">
        {% if homeMedia.length > 0 %}
          {% for item in homeMedia %}
          <div class="tile">
            {% if item.videoUrl %}
            <iframe src="{{ item.videoUrl | embedUrl }}" title="{{ item.caption or 'CVSA game video' }}" frameborder="0" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
            {% elif item.video %}
            <video controls preload="metadata" src="{{ item.video }}"></video>
            {% elif item.image %}
            {% respImage item.image, item.caption or "CVSA game day photo" %}
            {% endif %}
          </div>
          {% endfor %}
        {% else %}
          {% for i in range(0, 6) %}
          <div class="tile"><span>Photo</span></div>
          {% endfor %}
        {% endif %}
      </div>
      {% if homeMedia.length == 0 %}
      <p class="note" style="font-size:0.82rem;color:var(--ink-soft);font-style:italic;margin-top:10px;">Placeholder tiles — add real game-day photos from the Gallery page in the admin.</p>
      {% endif %}
    </div>
  </div>
</section>

<section class="band cta-band">
  <div class="container">
    <h2>Ready to run with us?</h2>
    <p>Spots are limited to keep games playable. Sign up for the next session or drop in as a walk-in — first-timers always welcome.</p>
    <div class="hero-ctas">
      <a href="/contact/" class="btn on-navy">Sign Up</a>
      <a href="/contact/" class="btn on-navy ghost">Contact Us</a>
    </div>
  </div>
</section>
