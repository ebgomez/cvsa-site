---
layout: page.njk
title: Gallery
subtitle: Game days, in pictures (and video).
permalink: /gallery/
---
{% set allMedia = site.quickPhotos | combineMedia(collections.galleryPhotos) %}
{% if allMedia.length == 0 %}
<div class="note-box"><strong>No photos yet —</strong> add game-day photos or videos through the admin (Gallery Photos & Videos, or Quick Gallery Photos for a fast bulk add) and they'll appear here automatically.</div>
<div class="gallery-grid">
  {% for i in range(0, 6) %}
  <div class="tile"><span>Photo</span></div>
  {% endfor %}
</div>
{% else %}
<div class="gallery-grid">
  {% for item in allMedia %}
  <div class="tile">
    {% if item.videoUrl %}
    <iframe src="{{ item.videoUrl | embedUrl }}" title="{{ item.caption or 'CVSA game video' }}" frameborder="0" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
    {% elif item.video %}
    <video controls preload="metadata" src="{{ item.video }}"></video>
    {% elif item.image %}
    {% respImage item.image, item.caption or "CVSA game day photo" %}
    {% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}
