  "title": "CVSA Hoops",
  "home": {
    "heroHeadline": "Real pickup basketball, run right, twice a week.",
    "heroDek": "Organized full and half-court games for adults 15+ in Riverbank — no chaos, no drama, just consistent, competitive runs for ball players of all ages.",
    "ctaHeading": "Ready to run with us?",
    "ctaText": "Spots are limited to keep games playable. Sign up for the next session or just drop in to check it out — first-timers always welcome.",
    "valueProps": [
      {
        "title": "Actually coordinated",
        "desc": "Attendance and game flow are managed every session — not a free-for-all. Everyone gets real run time."
      },
      {
        "title": "All skill levels, real competition",
        "desc": "From weekend regulars to former high school and college players — full court for those who want it, half court for a lower-impact option."
      },
      {
        "title": "Built by players, for players",
        "desc": "Thirty-plus years running open gym in the Central Valley, with no outside program cutting corners on coordination."
      },
      {
        "title": "Great Cardio",
        "desc": "Beats running on a treadmill or stair master. Many of our members lose weight and get a great sweat going in just 30 minutes of play."
      }
    ]
  }
